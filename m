+		fetch_config->parallel = git_config_int(k, v, ctx->kvi);
+		if (fetch_config->parallel < 0)
+			die(_("fetch.parallel cannot be negative"));
+		if (!fetch_config->parallel)
+			fetch_config->parallel = online_cpus();
+		return 0;
