new file mode 100644
index 0000000000..8977829052
--- /dev/null
+++ b/builtin/interactive.c
@@ -0,0 +1,250 @@
+#include <unistd.h>
+
+#include "builtin.h"
+#include "color.h"
+#include "gettext.h"
+#include "parse-options.h"
+#include "run-command.h"
+#include "strbuf.h"
+#include "strvec.h"
+#include "string-list.h"
+
+static const char *const builtin_interactive_usage[] = {
+	N_("git interactive"),
+	NULL
+};
+
+static void clear_screen_if_needed(void)
+{
+	if (isatty(1))
+		printf("\033[2J\033[H");
+}
+
+static void print_menu_header(void)
+{
+	printf("\n%sInteractive Git Helper%s\n", GIT_COLOR_BOLD_CYAN,
+	       GIT_COLOR_RESET);
+	printf("%sPick a task to run. Type the number and press Enter.%s\n",
+	       GIT_COLOR_FAINT, GIT_COLOR_RESET);
+}
+
+static void print_menu(void)
+{
+	printf("  %s1%s. %sstatus%s        %sShow the working tree state%s\n",
+	       GIT_COLOR_BOLD_GREEN, GIT_COLOR_RESET,
+	       GIT_COLOR_CYAN, GIT_COLOR_RESET,
+	       GIT_COLOR_FAINT, GIT_COLOR_RESET);
+    printf("  %s2%s. %sadd%s           %sStage changed files%s\n",
+           GIT_COLOR_BOLD_GREEN, GIT_COLOR_RESET,
+           GIT_COLOR_CYAN, GIT_COLOR_RESET,
+           GIT_COLOR_FAINT, GIT_COLOR_RESET);
+	printf("  %s3%s. %slog%s           %sShow recent commits%s\n",
+	       GIT_COLOR_BOLD_GREEN, GIT_COLOR_RESET,
+	       GIT_COLOR_CYAN, GIT_COLOR_RESET,
+	       GIT_COLOR_FAINT, GIT_COLOR_RESET);
+    printf("  %s4%s. %slog-graph%s           %sShow branches graph%s\n",
+	       GIT_COLOR_BOLD_GREEN, GIT_COLOR_RESET,
+	       GIT_COLOR_CYAN, GIT_COLOR_RESET,
+	       GIT_COLOR_FAINT, GIT_COLOR_RESET);
+	printf("  %s5%s. %sbranch%s        %sList local branches%s\n",
+	       GIT_COLOR_BOLD_GREEN, GIT_COLOR_RESET,
+	       GIT_COLOR_CYAN, GIT_COLOR_RESET,
+	       GIT_COLOR_FAINT, GIT_COLOR_RESET);
+	printf("  %s6%s. %shelp%s          %sOpen GIT  helper%s\n",
+	       GIT_COLOR_BOLD_GREEN, GIT_COLOR_RESET,
+	       GIT_COLOR_CYAN, GIT_COLOR_RESET,
+	       GIT_COLOR_FAINT, GIT_COLOR_RESET);
+	printf("  %s7%s. %squit%s          %sLeave the helper%s\n",
+	       GIT_COLOR_BOLD_GREEN, GIT_COLOR_RESET,
+	       GIT_COLOR_CYAN, GIT_COLOR_RESET,
+	       GIT_COLOR_FAINT, GIT_COLOR_RESET);
+}
+
+static int run_selected_command(const char *command_name,
+				 const char **args, size_t nr_args);
+
+static int collect_changed_files(struct string_list *files)
+{
+	struct child_process cp = CHILD_PROCESS_INIT;
+	struct strbuf out = STRBUF_INIT;
+	char *line, *path;
+	int ret;
+
+	cp.git_cmd = 1;
+	strvec_pushl(&cp.args, "status", "--porcelain", NULL);
+	ret = capture_command(&cp, &out, 0);
+	if (ret)
+		goto done;
+
+	for (line = out.buf; line && *line; ) {
+		char *newline = strchr(line, '\n');
+		if (newline)
+			*newline = '\0';
+		if (line[0] == ' ' || line[0] == '?') {
+			path = line + 3;
+			string_list_append(files, path);
+		}
+		if (!newline)
+			break;
+		line = newline + 1;
+	}
+
+done:
+	strbuf_release(&out);
+	return ret;
+}
+
+static int run_add_submenu(void)
+{
+	struct string_list files = STRING_LIST_INIT_NODUP;
+	struct strbuf input = STRBUF_INIT;
+	int ret = 0;
+
+	if (collect_changed_files(&files)) {
+		fprintf(stderr, "%sUnable to read changed files%s\n",
+			GIT_COLOR_BOLD_RED, GIT_COLOR_RESET);
+		string_list_clear(&files, 0);
+		return 0;
+	}
+
+	for (;;) {
+		clear_screen_if_needed();
+		printf("\n%sAdd changed files%s\n", GIT_COLOR_BOLD_MAGENTA,
+		       GIT_COLOR_RESET);
+		printf("%sSelect a file number, type 'a' for all, or 'q' to quit.%s\n",
+		       GIT_COLOR_FAINT, GIT_COLOR_RESET);
+		for (size_t i = 0; i < files.nr; i++)
+			printf("  %s%zu%s. %s\n", GIT_COLOR_BOLD_GREEN,
+			       i + 1, GIT_COLOR_RESET, files.items[i].string);
+		if (!files.nr) {
+			printf("  %sNo changed files to add.%s\n",
+			       GIT_COLOR_YELLOW, GIT_COLOR_RESET);
+		}
+		printf("\n%sChoice:%s ", GIT_COLOR_BOLD, GIT_COLOR_RESET);
+		fflush(stdout);
+
+		if (strbuf_getline(&input, stdin) == EOF) {
+			putchar('\n');
+			break;
+		}
+		strbuf_trim(&input);
+		if (!input.len || !strcmp(input.buf, "q") || !strcmp(input.buf, "quit"))
+			break;
+		if (!strcmp(input.buf, "a") || !strcmp(input.buf, "all")) {
+			ret = run_selected_command("add", (const char *[]){ ".", NULL }, 1);
+			break;
+		}
+
+		if (files.nr) {
+			char *end = NULL;
+			unsigned long idx = strtoul(input.buf, &end, 10);
+			if (end != input.buf && *end == '\0' && idx >= 1 && idx <= files.nr) {
+				const char *selected = files.items[idx - 1].string;
+				const char *args[] = { selected, NULL };
+				ret = run_selected_command("add", args, 1);
+				break;
+			}
+		}
+
+		fprintf(stderr, "%sInvalid choice:%s %s\n",
+			GIT_COLOR_BOLD_RED, GIT_COLOR_RESET, input.buf);
+	}
+
+	string_list_clear(&files, 0);
+	strbuf_release(&input);
+	return ret;
+}
+
+static int run_selected_command(const char *command_name,
+				 const char **args, size_t nr_args)
+{
+	struct child_process cp = CHILD_PROCESS_INIT;
+	size_t i;
+
+	printf("\n%sLaunching: git %s%s", GIT_COLOR_BOLD_YELLOW,
+	       command_name, GIT_COLOR_RESET);
+	for (i = 0; i < nr_args; i++)
+		printf(" %s", args[i]);
+	printf("\n");
+
+	strvec_push(&cp.args, command_name);
+	for (i = 0; i < nr_args; i++)
+		strvec_push(&cp.args, args[i]);
+	cp.git_cmd = 1;
+	return run_command(&cp);
+}
+
+int cmd_interactive(int argc,
+			   const char **argv,
+			   const char *prefix,
+			   struct repository *repo UNUSED)
+{
+	struct strbuf input = STRBUF_INIT;
+	const char *empty_args[] = { NULL };
+	const char *log_args[] = { "--oneline", "-5", NULL };
+    const char *log_graph_args[] = { "--oneline", "--graph","--decorate", "--all",  NULL };
+	const char *help_args[] = { "--help", NULL };
+	int ret = 0;
+	const struct option interactive_options[] = {
+		OPT_END()
+	};
+
+	argc = parse_options(argc, argv, prefix, interactive_options,
+				     builtin_interactive_usage, 0);
+	if (argc) {
+		error(_("unknown argument '%s'"), argv[0]);
+		usage(builtin_interactive_usage[0]);
+	}
+
+	for (;;) {
+		clear_screen_if_needed();
+		print_menu_header();
+		print_menu();
+		printf("\n%sChoose a number (1-7) or 'q' to quit:%s ",
+		       GIT_COLOR_BOLD, GIT_COLOR_RESET);
+		fflush(stdout);
+
+		if (strbuf_getline(&input, stdin) == EOF) {
+			putchar('\n');
+			break;
+		}
+
+		strbuf_trim(&input);
+		if (!input.len || !strcmp(input.buf, "q") || !strcmp(input.buf, "quit"))
+			break;
+
+		if (!strcmp(input.buf, "1")) {
+			ret = run_selected_command("status", empty_args, 0);
+		} else if (!strcmp(input.buf, "2")) {
+			ret = run_add_submenu();
+        } else if (!strcmp(input.buf, "3")) {
+			ret = run_selected_command("log", log_args, 2);
+		} else if (!strcmp(input.buf, "4")) {
+			ret = run_selected_command("log", log_graph_args, 4);
+		} else if (!strcmp(input.buf, "5")) {
+			ret = run_selected_command("branch", empty_args, 0);
+		} else if (!strcmp(input.buf, "6")) {
+			ret = run_selected_command("help", help_args, 1);
+		} else if (!strcmp(input.buf, "7")) {
+			break;
+		} else {
+			fprintf(stderr, "%sInvalid choice:%s %s\n",
+				GIT_COLOR_BOLD_RED, GIT_COLOR_RESET, input.buf);
+			continue;
+		}
+
+		if (ret)
+			break;
+
+		if (isatty(1)) {
+			printf("\n%sPress Enter to return to the menu...%s", GIT_COLOR_FAINT,
+			       GIT_COLOR_RESET);
+			fflush(stdout);
+			strbuf_getline(&input, stdin);
+			clear_screen_if_needed();
+		}
+	}
+
+	strbuf_release(&input);
+	return 0;
+}
