+static int git_fetch_config(const char *k, const char *v,
+			    const struct config_context *ctx, void *cb)
+{
+	struct fetch_config *fetch_config = cb;
+
+	if (!strcmp(k, "fetch.all")) {
+		fetch_config->all = git_config_bool(k, v);
+		return 0;
