+			    /* could be on an unborn branch */
+			    !strcmp("HEAD", s->revision) &&
+			    repo_get_oid(the_repository, "HEAD", &oid) ?
+			    empty_tree_oid_hex(the_repository->hash_algo) : s->revision);
+	}
+	color_arg_index = args.nr;
