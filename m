+struct commit_graft *lookup_commit_graft(struct repository *r, const struct object_id *oid)
+{
+	int pos;
+	prepare_commit_graft(r);
+	pos = commit_graft_pos(r, oid);
+	if (pos < 0)
+		return NULL;
+	return r->parsed_objects->grafts[pos];
+}
