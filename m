+static void prune_worktree(const char *id, const char *reason)
+{
+	if (show_only || verbose)
+		fprintf_ln(stderr, _("Removing %s/%s: %s"), "worktrees", id, reason);
+	if (!show_only)
+		delete_git_dir(id);
