+		while (len > 1 && args->base[len - 2] == '/')
+			len--;
+		if (args->verbose)
+			fprintf(stderr, "%.*s\n", (int)len, args->base);
+		err = write_entry(args, &args->tree->object.oid, args->base,
+				  len, 040777, NULL, 0);
+		if (err)
+			return err;
+	}
