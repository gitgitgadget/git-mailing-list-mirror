+		strbuf_addch(&buf, '\n');
+	}
+
+	if (cfg.extra_cc.nr)
+		strbuf_addstr(&buf, "Cc: ");
+	for (i = 0; i < cfg.extra_cc.nr; i++) {
+		if (i)
+			strbuf_addstr(&buf, "    ");
+		strbuf_addstr(&buf, cfg.extra_cc.items[i].string);
