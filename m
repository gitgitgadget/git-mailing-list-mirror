@@ -0,0 +1,37 @@
+#!/bin/sh
+
+test_description='git interactive command selection'
+
+. ./test-lib.sh
+
+test_expect_success 'interactive menu can dispatch a numbered selection' '
+	git_bin="$TEST_DIRECTORY/../git" &&
+	printf "1\n" | "$git_bin" interactive >output 2>err &&
+	test_grep "Launching: git status" output
+'
+
+test_expect_success 'add submenu can stage a selected changed file' '
+	tmpdir=$(mktemp -d) &&
+	outdir=$(mktemp -d) &&
+	git_bin="$TEST_DIRECTORY/../git" &&
+	test_when_finished "rm -rf \"$tmpdir\" \"$outdir\"" &&
+	(
+		cd "$tmpdir" &&
+		git init -q &&
+		git config user.name tester &&
+		git config user.email tester@example.com &&
+		printf "hello\n" >tracked.txt &&
+		git add tracked.txt &&
+		git commit -qm init &&
+		printf "more\n" >>tracked.txt &&
+		printf "5\n1\nq\n" | "$git_bin" interactive >"$outdir/output" 2>"$outdir/err"
+	) &&
+	test_grep "Add changed files" "$outdir/output" &&
+	(
+		cd "$tmpdir" &&
+		git diff --cached --name-only >staged &&
+		test_grep "tracked.txt" staged
+	)
+'
+
+test_done
