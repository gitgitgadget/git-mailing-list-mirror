+	FLEX_ALLOC_STR(e, path, path);
+	hashmap_entry_init(&e->entry, strhash(path));
+	existing = hashmap_get_entry(map, e, entry, NULL);
+	if (existing) {
+		free(e);
+		e = existing;
+	} else {
+		e->left[0] = e->right[0] = '\0';
+		hashmap_add(map, &e->entry);
+	}
+	strlcpy(is_right ? e->right : e->left, content, PATH_MAX);
