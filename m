<h4>B.1 Entity Key Pair Generation</h4>
<pre>import * as ed25519 from &#39;@noble/ed25519&#39;;
import { sha512 } from &#39;@noble/hashes/sha512&#39;;

// Set hash function for ed25519
ed25519.etc.sha512Sync =3D (...m) =3D&gt; sha512(ed25519.etc.concatBytes(..=
.m));

/**
 * Generate Ed25519 key pair for ASP entity
 */
async function generateEntityKeys(): Promise&lt;EntityKeyPair&gt; {
  // 1. Generate private key (32 bytes of entropy)
  const privateKey =3D ed25519.utils.randomPrivateKey();
 =20
  // 2. Derive public key
  const publicKey =3D await ed25519.getPublicKey(privateKey);
 =20
  // 3. Convert to hex strings
  const privateKeyHex =3D Buffer.from(privateKey).toString(&#39;hex&#39;);
  const publicKeyHex =3D Buffer.from(publicKey).toString(&#39;hex&#39;);
 =20
  // 4. Generate DID from public key
  const did =3D generateDID(publicKeyHex);
 =20
  return {
    privateKey: privateKeyHex,
    publicKey: publicKeyHex,
    did: did
  };
}

/**
 * Generate DID from public key
 */
function generateDID(publicKeyHex: string): string {
  // Multicodec prefix for Ed25519 public key: 0xed01
  const multicodecPrefix =3D &#39;ed01&#39;;
 =20
  // Base58 encode the key
  const base58Key =3D base58Encode(
    Buffer.from(multicodecPrefix + publicKeyHex, &#39;hex&#39;)
  );
 =20
  return `did:worldaibrain:key:z${base58Key}`;
}

/**
 * Sign ASP package with Ed25519
 */
async function signPackage(
  packageHash: string,
  privateKeyHex: string
): Promise&lt;string&gt; {
  const privateKey =3D Buffer.from(privateKeyHex, &#39;hex&#39;);
  const message =3D Buffer.from(packageHash, &#39;hex&#39;);
 =20
  const signature =3D await ed25519.sign(message, privateKey);
  return Buffer.from(signature).toString(&#39;hex&#39;);
}

/**
 * Verify ASP package signature
 */
async function verifySignature(
  packageHash: string,
  signatureHex: string,
  publicKeyHex: string
): Promise&lt;boolean&gt; {
  const message =3D Buffer.from(packageHash, &#39;hex&#39;);
  const signature =3D Buffer.from(signatureHex, &#39;hex&#39;);
  const publicKey =3D Buffer.from(publicKeyHex, &#39;hex&#39;);
 =20
  return await ed25519.verify(signature, message, publicKey);
}
