+		return 0;
+	}
+
+	if (!strcmp(k, "fetch.prunetags")) {
+		fetch_config->prune_tags = git_config_bool(k, v);
+		return 0;
+	}
+
+	if (!strcmp(k, "fetch.showforcedupdates")) {
+		fetch_config->show_forced_updates = git_config_bool(k, v);
+		return 0;
+	}
+
+	if (!strcmp(k, "submodule.recurse")) {
